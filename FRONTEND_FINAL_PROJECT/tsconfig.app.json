{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting - делаем строго, но удобно */
    "strict": true,
    "noUnusedLocals": false, // временно выключим, чтобы не ругался на пустые импорты
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,

    /* Это уберет обязательный 'import type' */
    "verbatimModuleSyntax": false
  },
  "include": ["src"]
}
